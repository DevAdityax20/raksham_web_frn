# Copy this file to `.env` (git-ignored) for local overrides.

# Base URL of the future Raksham backend API (not used yet).
# Example format: http://localhost:8000
VITE_API_BASE_URL=

# Where the Quick exit button sends the user (a neutral public page).
VITE_QUICK_EXIT_URL=https://www.google.com

# Temporary test login (test@gmail.com / test123) for use before the backend exists.
# Always on in local development. Set to true only if a production build should also accept it;
# the values are readable in the shipped JavaScript, so never rely on it for real security.
VITE_ENABLE_TEST_LOGIN=false
